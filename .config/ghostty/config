# This is the configuration file for Ghostty.
#
# The template does not set any default options, since Ghostty ships
# with sensible defaults for all options. Users should only need to set
# options that they want to change from the default.
#
# Run `ghostty +show-config --default --docs` to view a list of
# all available config options and their default values.
#
# Additionally, each config option is also explained in detail
# on Ghostty's website, at https://ghostty.org/docs/config.
#

font-family = CommitMonoErikb Nerd Font
font-size = 9

window-theme = ghostty
window-inherit-font-size = false
window-padding-balance = true
# window-padding-x = 0
window-padding-y = 0

macos-option-as-alt = true
copy-on-select = clipboard
gtk-toolbar-style = flat
confirm-close-surface=false
app-notifications = no-clipboard-copy

# Create splits

keybind = ctrl+shift+t>l=new_split:right
keybind = ctrl+shift+t>j=new_split:down
keybind = ctrl+shift+t>h=new_split:left
keybind = ctrl+shift+t>k=new_split:up

# Navigate between splits

keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up

# Resize splits

keybind = ctrl+shift+left=resize_split:left,15
keybind = ctrl+shift+down=resize_split:down,15
keybind = ctrl+shift+up=resize_split:up,15
keybind = ctrl+shift+right=resize_split:right,15 

# Close current split
# keybind = ctrl+shift+w=close_surface

# Fullscreen toggle
# keybind = ctrl+shift+f=toggle_fullscreen

# Config
config-file = ?auto/theme.ghostty
config-file = ?~/Library/Application Support/com.mitchellh.ghostty/config
