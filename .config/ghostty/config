font-family = CommitMonoErikb Nerd Font
font-size = 11
window-padding-x = 8
theme = Xcode Dark hc
# theme = Xcode Light hc 

# Pass Command-S through tmux to AstroNvim's save mapping.
keybind = super+s=text:\x13
# Keep Ghostty windows available without creating a second tab layer.
keybind = super+t=unbind
macos-option-as-alt = true
confirm-close-surface = false
